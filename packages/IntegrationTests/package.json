{
  "name": "@mj-biz-apps/collaboration-integration-tests",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Loads the Collaboration sample world through the entity gates.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import {cpSync,mkdirSync} from 'node:fs'; mkdirSync('dist/world/data',{recursive:true}); cpSync('src/world/data','dist/world/data',{recursive:true})\"",
    "load": "node dist/world/load-world.js",
    "purge": "node dist/world/purge-world.js"
  },
  "dependencies": {
    "@memberjunction/core": "6.1.3",
    "@memberjunction/core-entities": "6.1.3",
    "@memberjunction/generic-database-provider": "6.1.3",
    "@memberjunction/global": "6.1.3",
    "@memberjunction/sqlserver-dataprovider": "6.1.3",
    "@memberjunction/storage": "6.1.3",
    "@mj-biz-apps/collaboration-core": "workspace:*",
    "@mj-biz-apps/collaboration-core-entities-server": "workspace:*",
    "@mj-biz-apps/collaboration-entities": "workspace:*",
    "@mj-biz-apps/common-entities": "5.45.0",
    "mssql": "12.7.0"
  },
  "devDependencies": {
    "@types/mssql": "12.3.0",
    "typescript": "5.9.3"
  }
}
