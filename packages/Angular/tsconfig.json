{
  "extends": "../../tsconfig.angular.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "angularCompilerOptions": {
    "skipTemplateCodegen": true,
    "enableResourceInlining": true,
    "strictTemplates": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "src/**/*.test.ts"]
}
