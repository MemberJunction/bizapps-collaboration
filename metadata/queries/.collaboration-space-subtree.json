    "fields": {
      "Name": "Collaboration Space Subtree",
      "Description": "Returns all space IDs in the subtree reachable by the acting user, starting from PrimaryScopeRecordID. A space is in the subtree while its status allows agent retrieval (stage 1: statuses replace post-close access).",
      "CategoryID": "@lookup:MJ: Query Categories.Name=Collaboration",
      "Status": "Approved",
      "SQLDialectID": "@lookup:MJ: SQL Dialects.Name=T-SQL",
      "UsesTemplate": true,
      "Reusable": false,
      "AuditQueryRuns": false,
      "CacheEnabled": false,
      "IsMaterialized": false,
      "SQL": "SELECT DISTINCT CONVERT(NVARCHAR(36), cs.[SpaceID]) AS [SpaceID]\nFROM [__mj_BizAppsCollaboration].[fnCollaborationChatScope](\n    CASE WHEN LEN(TRIM({{ PrimaryScopeRecordID | sqlString }})) = 36 THEN TRY_CAST({{ PrimaryScopeRecordID | sqlString }} AS UNIQUEIDENTIFIER) ELSE NULL END,\n    CASE WHEN LEN(TRIM({{ UserID | sqlString }})) = 36 THEN TRY_CAST({{ UserID | sqlString }} AS UNIQUEIDENTIFIER) ELSE NULL END\n) AS cs"
    },
