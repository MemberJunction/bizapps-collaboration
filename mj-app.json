{
  "$schema": "https://schema.memberjunction.org/mj-app/v1.json",
  "manifestVersion": 1,
  "name": "mj-bizapps-collaboration",
  "displayName": "BizApps Collaboration",
  "description": "Spaces: the permission boundary and the agent retrieval boundary for collaborative team and outside work.",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "publisher": {
    "name": "MemberJunction",
    "url": "https://memberjunction.com"
  },
  "repository": "https://github.com/MemberJunction/bizapps-collaboration",
  "mjVersionRange": ">=6.1.2 <7.0.0",
  "dependencies": {
    "mj-bizapps-common": {
      "version": ">=5.46.0 <6.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-common"
    },
    "mj-bizapps-tasks": {
      "version": ">=1.5.0 <2.0.0",
      "repository": "https://github.com/MemberJunction/bizapps-tasks"
    }
  },
  "schema": {
    "name": "__mj_BizAppsCollaboration",
    "createIfNotExists": true
  },
  "migrations": {
    "directory": "migrations",
    "engine": "skyway"
  },
  "metadata": {
    "directory": "metadata"
  },
  "packages": {
    "server": [
      {
        "name": "@mj-biz-apps/collaboration-server",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsCollaborationServer"
      },
      {
        "name": "@mj-biz-apps/collaboration-core-entities-server",
        "role": "library"
      }
    ],
    "client": [
      {
        "name": "@mj-biz-apps/collaboration-ng",
        "role": "bootstrap",
        "startupExport": "LoadBizAppsCollaborationClient"
      },
      {
        "name": "@mj-biz-apps/collaboration-ng-widgets",
        "role": "library"
      }
    ],
    "shared": [
      {
        "name": "@mj-biz-apps/collaboration-entities",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/collaboration-actions",
        "role": "library"
      },
      {
        "name": "@mj-biz-apps/collaboration-core",
        "role": "library"
      }
    ]
  },
  "code": {
    "visibility": "public",
    "sourceDirectory": "packages"
  },
  "categories": ["Business", "Collaboration"],
  "tags": ["space", "membership", "permissions"]
}
